<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(TargetFrameworkNet10)</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<AssemblyName>Wormhole.Sync.Tests</AssemblyName>
		<RootNamespace>Wormhole.Sync.Tests</RootNamespace>
		<NoWarn>$(NoWarn);CS1587;CS1591</NoWarn>

		<IsPackable>false</IsPackable>
		<!--<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>-->
		<LangVersion>12.0</LangVersion>

		<!-- Enable Microsoft.Testing.Platform support for xUnit v3 -->
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
	</PropertyGroup>
	<PropertyGroup>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>
	<PropertyGroup>
		<!-- Static analysis settings -->
		<EnableNETAnalyzers>false</EnableNETAnalyzers>
		<AnalysisLevel>none</AnalysisLevel>
		<RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
		<RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
	</PropertyGroup>
