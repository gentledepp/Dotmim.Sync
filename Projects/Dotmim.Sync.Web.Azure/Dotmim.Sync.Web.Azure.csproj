<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(TargetFrameworkNetStandard);$(TargetFrameworkNet10)</TargetFrameworks>
        <AssemblyName>Wormhole.Sync.Web.Azure</AssemblyName>
        <PackageId>Wormhole.Sync.Web.Azure</PackageId>
        <RootNamespace>Wormhole.Sync.Web.Azure</RootNamespace>
        <Authors>Sebastien Pertus</Authors>
        <Company>Microsoft</Company>
        <Title>Wormhole.Sync.Web.Azure</Title>
        <Summary>Azure Blob Storage provider for Wormhole.Sync batch storage</Summary>
        <Description>Azure Blob Storage implementation for Wormhole.Sync batch storage. Enables scale-out deployments where any server instance can read/write batch files using Azure Blob Storage.</Description>
        <RepositoryType>git</RepositoryType>
        <PackageTags>Data, Database, Sync, Synchronization, Azure, Blob, Storage, Wormhole.Sync, NetStandard</PackageTags>
        <ApplicationIcon>favicon.ico</ApplicationIcon>
        <PackageIcon>packageIcon.png</PackageIcon>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn)</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\docs\assets\packageIcon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == '$(TargetFrameworkNetStandard)' ">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.2.0" />
    </ItemGroup>


    <ItemGroup Condition=" '$(TargetFramework)' == '$(TargetFrameworkNet10)' ">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dotmim.Sync.Core\Dotmim.Sync.Core.csproj" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!-- for nuget sources debug-->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <IncludeSource>true</IncludeSource>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <!---normalizes filepaths when build by ci (CI is set by ci pipeline)-->
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
