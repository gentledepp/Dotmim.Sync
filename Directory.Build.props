<Project>
    <Sdk Name="DotNet.ReproducibleBuilds.Isolated" Version="1.2.4" />

    <PropertyGroup>
        <TargetFrameworkNetStandard>netstandard2.0</TargetFrameworkNetStandard>
        <TargetFrameworkNet10>net10.0</TargetFrameworkNet10>
		<TargetFrameworkNetframework>net48</TargetFrameworkNetframework>

        <LangVersion>12.0</LangVersion>

        <!-- Workaround for NETSDK1226 on .NET 10 SDK (10.0.301): prune package data for the
             net10.0 shared frameworks is missing, which fails the build. Safe to ignore. -->
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>

        <!-- Generate the lock file -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <!-- Restore the exact packages as listed in the lock file -->
        <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>

        <Version>1.8.5.0</Version>
        <VersionSuffix>$(VersionSuffix)</VersionSuffix>
        <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>

        <PackageReleaseNotes>
            # 1.8.5.0
            - optimized incremental upload: the server now verifies that every announced client batch part was accumulated before applying. If the (volatile) server session lost an earlier batch part mid-upload (eviction / stale-session recreation / concurrent session write), the server no longer applies a partial set - which could commit a child row without its parent and cause transient foreign-key violations - but fails fast with HttpSessionLostException so the sync aborts and the next sync restarts the whole upload
            # 1.8.4.0
            - added DeleteMetadata interceptor that allows to retain metadata rows of child tables to avoid sqlite foreign key constraint errors because the parent row is deleted but the child row is not
			# 1.8.3.0
            - when a supported sync migration was configured before the local sqlite db was ever synchronized, the comparison caused a NRE
	        # 1.8.2.0
	        - fixed NullReferenceException in WebServerAgent
			# 1.8.1.0
			- provies SyncMigrationOptions that allow to easily register migrations using the Microsoft.Extensions.Options framework
			# 1.8.0.0
			- supports additive schema-migration
			# 1.7.1.0
			- introduced IErrorHandler interface on .Server
			- fixed AspNetSessionCacheStore (providing HttpContext per request)
			# 1.7.0.0
			- added azure blob storage support for batch files
			- added async background batch creation support (local implementation and hangfire)
			# 1.6.9.1
			- options.AutoUpgrade allows to disable the default dotmim upgrade procedure
			# 1.6.9.0
			- improved sync performance
			Bulk-Insert/Update/Delete for SQLite
			Bulk-conflict detection and resolution SQLITE/SqlServer
			UnifiedBatchSerializer performance improvements (writing)
			# Version 1.6.8.0
			- removed usage of 'dynamic' for iOS (Attempting to JIT compile method)
			# Version 1.6.7.0
			- OnRowsChangesValidating interceptor with "MarkAsConflict" method
			- fixed GetRow stored procedure using FULL OUTER JOIN (works if base row was deleted or if tracking row was cleaned up)
			# Version 1.6.6.0
			- tracked columns are indexed
			# Version 1.6.5.0
			- added soucelink debugging
			- can add scopeinfoclientparameters to add custom columns to the server-side scope_info_client table
			# Version 1.6.3.0
			- you can set a prefix/postfix for scope_info and scope_info_client tables in SyncOptions
			# Version 1.6.2.0
			- GetProvisioningSqlScriptsAsync now includes the scope_info and scope_info_client tables
			# Version 1.6.1.0
			- can define custom script separator
			- added cancellation support for all SyncAgent.SynchronizeAsync overloads
			- Renamed SyncWay to SyncRole for clarity
			- conflictresolutionpolicy is not reversed by the sync agent anymore (breaking change)
		</PackageReleaseNotes>

        <PackageTags>Data, Database, Sync, Synchronization, Framework, Sql, MySql, MariaDB, PostgreSql, Sqlite, Wormhole.Sync, NetStandard, SyncFramework</PackageTags>
        <PackageProjectUrl>https://dotmimsync.readthedocs.io/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Mimetis/Dotmim.Sync</RepositoryUrl>

        <!-- Publish the repository URL in the built .nupkg (in the NuSpec <Repository> element) -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <!-- Embed source files that are not tracked by the source control manager in the PDB -->
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!-- Create a separate pdb file to allow nuget push -->
        <DebugType>full</DebugType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedAllSources>true</EmbedAllSources>
        <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>

    </PropertyGroup>

    <PropertyGroup>

        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

        <!-- Static analysis settings -->
        <Features>strict</Features>
        <WarningLevel>9999</WarningLevel>
        <AnalysisLevel>latest-all</AnalysisLevel>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>

        <NoWarn></NoWarn>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
